{ 
    "manifest_version": 3,
    "name": "DSA_Notes",
    "version": "3",
    "description": "Take notes on DSA questions directly on leetcode",

    "permissions": ["storage","webNavigation"],
    "host_permissions": ["https://leetcode.com/*","https://codeforces.com/*"],

    "background": {
        "service_worker": "src/background/background.js",
        "type": "module"
    },

    "content_scripts": [
        {
            "matches": ["https://leetcode.com/*","https://codeforces.com/*"],
            "js": ["src/content/content.js"],
            "css": ["src/content/panel.css"],
            "run_at": "document_idle"
        }
    ],

    "web_accessible_resources": [
        {
            "resources": ["src/content/panel.css"],
            "matches": ["https://leetcode.com/*","https://codeforces.com/*"]
        }
    ],

    "commands": {
        "toggle_panel": {
            "suggested_key": {
                "default": "Alt+L"
            },
            "description": "Toggle the notes panel"
        },
        "toggle_mode": {
            "suggested_key": {
                "default": "Alt+K"
            },
            "description": "Toggle the panel mode"
        }
    },

    "action": {
        "default_popup": "src/popup/popup.html",
        "default_title": "DSA Notes"
    }
}